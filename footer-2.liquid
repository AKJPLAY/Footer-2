{% schema %}
{
    "name": "Footer 2",
    "class": "footer-2",
    "presets": [
        {
            "name":"Footer 2"
        }
    ],
    "settings": [
        {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo"
        },
        {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#030712"
        },
        
        {
            "type": "color",
            "id": "color",
            "label": "Color",
            "default": "#ffffff"
        },
        {
            "type": "header",
            "content": "Social Media"
        },
        {
            "type": "color",
            "id": "social_background",
            "label": "Background",
            "default": "#457F8D"
        },
        {
            "type": "color",
            "id": "social_color",
            "label": "Color",
            "default": "#ffffff"
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Border Color",
            "default": "#E5E7EB"
        }
    ]
}
{% endschema %}