{% style %}
    #shopify-section-{{ section.id }} {
        --bg: {{ section.settings.background }};
        --border-color: {{ section.settings.border_color }};
        --color: {{ section.settings.color }};
        --social-bg: {{ section.settings.social_background }};
        --social-color: {{ section.settings.social_color }};
    }
    #shopify-section-{{ section.id }} {
        background-color: var(--bg, #030712);
        color: var(--color, #fff);
    }
    #shopify-section-{{ section.id }} a {
        text-decoration: none;
        cursor: pointer;
    }
    #shopify-section-{{ section.id }} a:link,
    #shopify-section-{{ section.id }} a:visited {
        color: var(--color, #fff);
    }
    #shopify-section-{{ section.id }} .innner-area {
        padding: 40px 70px;
        display: grid;
        gap: 50px;
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area {
        padding: 30px;
        }
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s {
        display: grid;
        grid-template-columns: 1fr 2fr 1fr;
        align-items: center;
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .top-area-s {
        display: block;
        }
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .logo_wrapper a .main-logo {
        width: 165px;
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu {
        text-align: center;
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu {
        text-align: left;
        }
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu ul li {
        margin: 0 10px;
        display: inline-block;
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu ul li {
        margin: 0;
        width: calc(50% - 10px);
        }
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu ul li:first-child {
        margin-left: 0px;
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu ul li:last-child {
        margin-right: 0px;
    }
    #shopify-section-{{ section.id }} .innner-area .top-area-s .center-menu ul li a {
        padding-block: 15px;
        display: block;
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s {
        display: grid;
        grid-template-columns: 1fr max-content 1fr;
        align-items: center;
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s::before {
        content: "";
        display: block;
        background: var(--border-color, #E5E7EB);
        opacity: 0.2;
        width: 100%;
        height: 1px;
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s::after {
        content: "";
        display: block;
        background: var(--border-color, #E5E7EB);
        opacity: 0.2;
        width: 100%;
        height: 1px;
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s .social-icons {
        display: flex;
        padding: 14px 28px;
        background: var(--social-bg, #457F8D);
        border-radius: 94px;
        width: -moz-max-content;
        width: max-content;
        list-style: none;
        gap: 15px;
        color: var(--social-color, #ffffff);
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s .social-icons li {
        list-style: none;
    }
    #shopify-section-{{ section.id }} .innner-area .middel-area-s .social-icons li a {
        color: var(--social-color, #fff);
    }
    #shopify-section-{{ section.id }} .innner-area .bottom-area-s {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .bottom-area-s {
        display: block;
        }
    }
    #shopify-section-{{ section.id }} .innner-area .bottom-area-s .left-s {
        display: flex;
        gap: 20px;
    }
    #shopify-section-{{ section.id }} .innner-area .bottom-area-s .left-s .email-s,
    #shopify-section-{{ section.id }} .innner-area .bottom-area-s .left-s .contact-s {
        flex: 0 0 calc(50% - 10px);
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .bottom-area-s .left-s .email-s .details,
        #shopify-section-{{ section.id }} .innner-area .bottom-area-s .left-s .contact-s .details {
        overflow-wrap: anywhere;
        }
    }
    @media screen and (max-width: 991px) {
        #shopify-section-{{ section.id }} .innner-area .bottom-area-s .right-s {
        text-align: center;
        padding: 30px;
        }
    }
{% endstyle %}
